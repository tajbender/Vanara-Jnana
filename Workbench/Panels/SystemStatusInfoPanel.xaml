<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jnana.Workbench.Panels.SystemStatusInfoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="using:Jnana.Workbench.Panels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="23" Opacity="0.7" Padding="8" Text="System Status"/>
        <StackPanel Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <StackPanel Orientation="Horizontal" Padding="13" HorizontalAlignment="Stretch">
                <TextBlock Text="Vanara version:" VerticalAlignment="Center"/>
                <Border Background="#0589D7" CornerRadius="4" Opacity="0.8" Padding="8,2" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind VanaraCoreVersionInfo}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Padding="13" HorizontalAlignment="Stretch">
                <TextBlock Text="jñāna version:" VerticalAlignment="Center"/>
                <Border Background="#2D6466" CornerRadius="4" Opacity="0.8" Padding="8,2" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind AppPackageVersionInfo}"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
