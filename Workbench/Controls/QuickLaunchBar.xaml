<UserControl
    x:Class="Jnana.Workbench.Controls.QuickLaunchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- add 09:42 apple bar -->

    <Grid VerticalAlignment="Stretch">
        <!-- Außenrahmen: etwas schlanker, weicher -->
        <Border BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
                BorderThickness="3"
                CornerRadius="20"
                Padding="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel Orientation="{x:Bind Orientation}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Spacing="10">

                <!-- Titel + Logo -->
                <StackPanel Orientation="Vertical"
                            Spacing="6">
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Text="Vanara Jñāna" />
                    <Image MaxHeight="96"
                           Source="/Assets/StoreLogo.png"
                           Stretch="Uniform" />
                </StackPanel>

                <!-- Version + User TODO: Bind UserName, add MachineName to the bottom area -->
                <StackPanel Orientation="Horizontal"
                            Visibility="Collapsed"
                            Spacing="6">
                    <TextBlock FontStyle="Italic"
                               FontWeight="SemiBold"
                               Text="v1.269"
                               Opacity="0.8" />
                    <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{x:Bind UserDisplayName}" />
                    </Border>
                </StackPanel>

                <!-- Status‑Area (später aktivierbar) -->
                <StackPanel Orientation="Vertical"
                            Spacing="4">
                    <Border CornerRadius="6"
                            BorderThickness="1"
                            Padding="6"
                            Visibility="Collapsed">
                        <TextBlock Text="Network status: {x:Bind NetworkStatus}" />
                    </Border>
                    <Border CornerRadius="6"
                            BorderThickness="1"
                            Padding="6"
                            Visibility="Collapsed">
                        <TextBlock Text="GitHub status: {x:Bind GitHubStatus}" />
                    </Border>
                </StackPanel>

                <!-- Quick Navigation -->
                <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                    <Button Click="OnWorkbenchClick"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Padding="10" Spacing="8">
                            <FontIcon Glyph="&#xEC7A;" />
                            <TextBlock Text="Workbench"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Button>

                    <AppBarSeparator />

                    <Button Click="OnNuGetsClick"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Padding="10" Spacing="8">
                            <FontIcon Glyph="&#xEC7A;" />
                            <TextBlock Text="NuGets"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnGitHubClick"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Padding="10" Spacing="8">
                            <FontIcon Glyph="&#xEC7A;" />
                            <TextBlock Text="GitHub"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Button>


