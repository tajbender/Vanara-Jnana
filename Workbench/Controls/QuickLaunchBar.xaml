<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Jnana.Workbench.Controls.QuickLaunchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Border Grid.Column="0" BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}" BorderThickness="3" CornerRadius="32">
            <Grid x:Name="HeaderLogoGrid" CornerRadius="6" Opacity=".76">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <Image Grid.Row="1" MaxHeight="64" Opacity="0.66" Source="/Assets/StoreLogo.png" VerticalAlignment="Stretch">
                        <Image.OpacityTransition>
                            <ScalarTransition Duration="3:4:5"/>
                        </Image.OpacityTransition>
                    </Image>
                </Button>
                <Button Grid.Row="1" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;"/>
                        <TextBlock Text="Jñāna Workbench"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;"/>
                        <TextBlock Text="Packages"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;"/>
                        <TextBlock Text="GitHub"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="4" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;"/>
                        <TextBlock Text="Issues"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="5" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;"/>
                        <TextBlock Text="Discussions"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="6" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;"/>
                        <TextBlock Text="Samples"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="7" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;"/>
                        <TextBlock Text="Labs" TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="BottomStatusGrid" Grid.Row="1" CornerRadius="8" HorizontalAlignment="Stretch" Opacity="0.76" Padding="42,23" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <FontIcon Grid.Column="0" Grid.Row="1" Glyph="&#xE7F8;"/>
            <FontIcon Grid.Column="1" Grid.Row="1" Glyph="&#xE7F8;"/>
            <FontIcon Grid.Column="2" Grid.Row="1" Glyph="&#xE7F8;"/>
            <AppBarSeparator Grid.ColumnSpan="3" Grid.Row="2" Height="23" MinWidth="128"/>
            <FontIcon Grid.Column="0" Grid.Row="3" Glyph="&#xE7F8;"/>
            <FontIcon Grid.Column="1" Grid.Row="3" Glyph="&#xE7F8;"/>
            <FontIcon Grid.Column="2" Grid.Row="3" Glyph="&#xE7F8;"/>
        </Grid>
    </Grid>
</UserControl>