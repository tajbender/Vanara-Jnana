<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Jnana.Workbench.Controls.QuickLaunchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Border Grid.Column="0" Grid.RowSpan="2" CornerRadius="32"
                BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}" BorderThickness="3">
            <StackPanel HorizontalAlignment="Stretch"
                        HorizontalSnapPointsChanged="StackPanel_HorizontalSnapPointsChanged"
                        Orientation="{x:Bind Orientation}"
                        Padding="7"
                        VerticalAlignment="Stretch">
                <Grid x:Name="HeaderLogoGrid" CornerRadius="6" Opacity=".76">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Grid.Column="0" Grid.Row="0">!!!</Button>
                    <TextBlock Grid.Column="1" Grid.Row="0" FontSize="23" FontWeight="Bold" HorizontalAlignment="Left"
                               Text="Jñāna" VerticalAlignment="Top" />
                    <Image Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" HorizontalAlignment="Center" MaxHeight="64"
                           Opacity="0.66" Source="/Assets/StoreLogo.png" VerticalAlignment="Stretch">
                        <Image.OpacityTransition>
                            <ScalarTransition Duration="3:4:5" />
                        </Image.OpacityTransition>
                    </Image>
                    <Button Grid.ColumnSpan="2" Grid.Row="2" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                            <FontIcon Glyph="&#xEC7A;" />
                            <TextBlock Text="Workbench" HorizontalTextAlignment="Left"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.ColumnSpan="2" Grid.Row="3" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                            <FontIcon Glyph="&#xEC7A;" />
                            <TextBlock Text="GitHub" HorizontalTextAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Right side of the grid -->
                <!--<TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right"
                               Text="v1.269 (debug) - tres hombres" Padding="7" />
                    <Border Grid.Column="1" Grid.Row="1" CornerRadius="7" BorderThickness="3"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock FontWeight="SemiBold" Margin="7" Text="{x:Bind UserDisplayName}" />
                    </Border>
                    <Border Grid.Column="1" Grid.Row="2" CornerRadius="7" BorderThickness="3">
                        <TextBlock Text="{x:Bind NetworkStatus}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Grid.Row="3" CornerRadius="7" BorderThickness="3">
                        <TextBlock Text="{x:Bind GitHubNetworkStatus}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Border>-->
                <!-- Navigation section -->
                <Button Click="OnWorkbenchClick" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="Workbench" HorizontalTextAlignment="Left"/>
                    </StackPanel>
                </Button>
                <Button Click="OnGitHubBrowserClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="GitHub" HorizontalTextAlignment="Left" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnGitHubBrowserClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="Issues" HorizontalTextAlignment="Left" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnGitHubBrowserClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="Discussions" HorizontalTextAlignment="Left" TextWrapping="WrapWholeWords" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnNuGetsClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="Packages" HorizontalTextAlignment="Left" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
                <Button Click="OnSamplesClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock HorizontalTextAlignment="Left" Text="Samples" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
                <Button Click="OnScienceLabsClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock HorizontalTextAlignment="Left" Text="Science labs" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1">
            <!-- Bottom section -->
            <Grid x:Name="BottomArea" CornerRadius="8" HorizontalAlignment="Stretch"
                      Opacity="0.76" Padding="42,23" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <FontIcon Grid.Column="0" Grid.Row="1" Glyph="&#xE7F8;" />
                <FontIcon Grid.Column="1" Grid.Row="1" Glyph="&#xE9D9;" />
                <FontIcon Grid.Column="2" Grid.Row="1" Glyph="&#xE7F8;" />
                <AppBarSeparator Grid.ColumnSpan="3" Grid.Row="2"/>
                <FontIcon Grid.Column="0" Grid.Row="3" Glyph="&#xE9D9;" />
                <FontIcon Grid.Column="1" Grid.Row="3" Glyph="&#xE7F8;" />
                <FontIcon Grid.Column="2" Grid.Row="3" Glyph="&#xE9D9;" />
            </Grid>
        </Border>
    </Grid>
</UserControl>