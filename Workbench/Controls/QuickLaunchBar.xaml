<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Jnana.Workbench.Controls.QuickLaunchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}" BorderThickness="3" CornerRadius="32" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" MaxHeight="84" Source="/Assets/StoreLogo.png" VerticalAlignment="Stretch"/>
        <Button Grid.Row="1" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnWorkbenchClick">
            <StackPanel>
                <TextBlock FontSize="32" HorizontalAlignment="Center" Text="🧠"/>
                <TextBlock HorizontalAlignment="Center" Text="Workbench"/>
            </StackPanel>
        </Button>
        <Border Grid.Row="2" Height="16"/>
        <Button Grid.Row="3" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnNuGetsClick">
            <StackPanel>
                <TextBlock FontSize="32" HorizontalAlignment="Center" Text="📦"/>
                <TextBlock HorizontalAlignment="Center" Text="Vanara NuGets"/>
            </StackPanel>
        </Button>
        <Border Grid.Row="4" Height="16"/>
        <Button Grid.Row="5" CornerRadius="6,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnGitHubClick">
            <StackPanel>
                <TextBlock FontSize="32" HorizontalAlignment="Center" Text="🌿"/>
                <TextBlock HorizontalAlignment="Center" Text="GitHub"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="6" CornerRadius="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnGitHubIssuesClick">
            <StackPanel>
                <TextBlock FontSize="32" HorizontalAlignment="Center" Text="🐞"/>
                <TextBlock HorizontalAlignment="Center" Text="Issues"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="7" CornerRadius="0,0,6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnGitHubDiscussionsClick">
            <StackPanel>
                <TextBlock FontSize="32" HorizontalAlignment="Center" Text="💬"/>
                <TextBlock HorizontalAlignment="Center" Text="Discussions"/>
            </StackPanel>
        </Button>
        <Border Grid.Row="8" Height="16"/>
        <Button Grid.Row="9" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        IsEnabled="False" Opacity="0.5">
            <StackPanel>
                <TextBlock FontSize="32" HorizontalAlignment="Center" Text="📚"/>
                <TextBlock HorizontalAlignment="Center" Text="Samples"/>
            </StackPanel>
        </Button>
        <Border Grid.Row="10" Height="16"/>
        <Button Grid.Row="11" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        IsEnabled="False" Opacity="0.5">
            <StackPanel>
                <TextBlock FontSize="32" HorizontalAlignment="Center" Text="🧪"/>
                <TextBlock HorizontalAlignment="Center" Text="jñāna Science Lab"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
