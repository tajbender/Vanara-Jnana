<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Jnana.Workbench.Controls.QuickLaunchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- TODO: Add a title or description for the quick launch bar -->
    <!-- TODO: Add a setter for the title -->

    <Grid VerticalAlignment="Stretch">
        <Border BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
                BorderThickness="7" CornerRadius="32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch" HorizontalSnapPointsChanged="StackPanel_HorizontalSnapPointsChanged"
                        Orientation="{x:Bind Orientation}" Padding="8" Spacing="8" VerticalAlignment="Stretch">
                <Grid x:Name="HeaderSectionGrid" Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" FontSize="23" FontWeight="Bold" Text="Vanara Jñāna"/>
                    <Image Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" 
                           MaxHeight="128" Source="/Assets/StoreLogo.png" VerticalAlignment="Stretch" />
                    <!-- Right side of the grid -->
                    <TextBlock Grid.Column="1" Grid.Row="0" FontStyle="Italic" FontWeight="SemiBold" Text="v1.269" Padding="7,5,7,7"/>
                    <Border Grid.Column="1" Grid.Row="1" BorderThickness="3" CornerRadius="7">
                        <TextBlock FontWeight="SemiBold" HorizontalAlignment="Left" Text="{x:Bind UserDisplayName}"/>
                        <!-- TODO: Load avatar -->
                    </Border>
                    <Border Grid.Column="1" Grid.Row="2" CornerRadius="7" BorderThickness="3">
                        <TextBlock FontWeight="SemiBold" HorizontalAlignment="Left" Text="{x:Bind MachineDisplayName}"/>
                        <!-- TODO: Use cool machine glyph styling -->
                    </Border>
                    <!-- Bottom area-->
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" CornerRadius="7" BorderThickness="3" Visibility="Collapsed">
                        <!-- todo: add Heartbeat animated status -->
                        <TextBlock Margin="7" Text="Network status: {x:Bind NetworkStatus}" />
                    </Border>
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" CornerRadius="7" BorderThickness="3"  Visibility="Collapsed">
                        <!-- todo: add Heartbeat animated status -->
                        <TextBlock Margin="7" Text="GitHub status: {x:Bind GitHubStatus}" />
                    </Border>
                </Grid>
                <!-- Quick Navigation section -->
                <Button Click="OnWorkbenchClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" BorderBrush="AliceBlue">
                    <!-- TODO: Move Accent color brush for button into styles -->
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="Workbench" HorizontalTextAlignment="Left" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
                <AppBarSeparator />
                <Button Click="OnNuGetsClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="8">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="NuGets" HorizontalTextAlignment="Left" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
                <ComboBox>
                    <ComboBox.Resources>
                        <!-- TODO: Move Accent color brush into styles -->
                        <SolidColorBrush x:Key="AccentBrush" Color="#FFB26EFF" />
                    </ComboBox.Resources>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="24,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Grid>
                                            <!-- Accent‑Stripe on the left hand side -->
                                            <Rectangle x:Name="AccentStripe" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" Opacity="0.23" Width="4" />
                                            <ContentPresenter Margin="8,8" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <!-- Vanara on  GitHub ComboBox -->
                    <ComboBoxItem IsSelected="False">
                        <!-- todo: Add image, stretch, add "Goto" button" -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Vanara on GitHub" FontWeight="SemiBold" Opacity="0.76" VerticalAlignment="Center"/>
                            <Button VerticalAlignment="Center">open...</Button>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Content="Code" />
                    <ComboBoxItem Content="Downloads" />
                    <ComboBoxItem Content="Issues" />
                    <ComboBoxItem Content="Pull Requests" />
                    <ComboBoxItem IsEnabled="False">
                        <!-- Separator -->
                        <Rectangle Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Height="1" Margin="6,2" Opacity="0.42" />
                    </ComboBoxItem>
                    <!-- WinClassicSamples -->
                    <ComboBoxItem IsEnabled="False">
                        <TextBlock Text="WinClassicSamples" FontWeight="SemiBold" Opacity="0.6" />
                    </ComboBoxItem>
                    <ComboBoxItem Content="Code" />
                </ComboBox>
                <AppBarSeparator />
                <Button Click="OnSamplesClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="Samples &amp; Jñāna science Labs" HorizontalTextAlignment="Left"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
                <Button Click="OnToolsAndUtilitiesClick" CornerRadius="6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
                        <FontIcon Glyph="&#xEC7A;" />
                        <TextBlock Text="Tools &amp; Utilities" HorizontalTextAlignment="Left"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Button>
                <Grid x:Name="BottomArea" CornerRadius="8" HorizontalAlignment="Stretch"
                      Opacity="0.76" Padding="42,23" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Height="92" HorizontalAlignment="Stretch" MinHeight="42">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Drop Items to this area here..." TextWrapping="WrapWholeWords"/>
                            <TextBlock Text="Tabs, Folders, Shortcuts..." TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                    </Border>
                    <FontIcon Grid.Column="0" Grid.Row="1" Glyph="&#xE7F8;" />
                    <FontIcon Grid.Column="1" Grid.Row="1" Glyph="&#xE9D9;" />
                    <FontIcon Grid.Column="2" Grid.Row="1" Glyph="&#xE7F8;" />
                    <FontIcon Grid.Column="0" Grid.Row="2" Glyph="&#xE9D9;" />
                    <FontIcon Grid.Column="1" Grid.Row="2" Glyph="&#xE7F8;" />
                    <FontIcon Grid.Column="2" Grid.Row="2" Glyph="&#xE9D9;" />
                    <Button Grid.Column="0" Grid.Row="3" Click="OnSysInfoClick" CornerRadius="6" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical" Padding="8" Spacing="8">
                            <FontIcon Glyph="&#xEC7A;" />
                            <TextBlock Text="System Information" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Grid.Row="3" Click="OnSettingsClick" CornerRadius="6" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical" Padding="8" Spacing="8">
                            <FontIcon Glyph="&#xEC7A;"/>
                            <TextBlock Text="Settings &amp; Preferences" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Grid.Row="3" Click="OnSettingsClick" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Vertical" Padding="8" Spacing="8">
                            <FontIcon Glyph="&#xEC7A;"/>
                            <TextBlock Text="Need Help?" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>