<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Jnana.Workbench.Controls.VanaraReleasePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <!--<DockPanel Background="#222" Padding="10">
            <TextBlock FontSize="18" Foreground="White" Text="Vanara Release Timeline"/>
            <Button Content="Refresh" Click="Refresh_Click" Margin="10 0 0 0"/>
        </DockPanel>-->

        <!-- Release List -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Releases}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#444" BorderThickness="0 0 0 1" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PublishedAt}" FontSize="12" Foreground="#AAA"/>
                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Error Overlay -->
        <Border x:Name="ErrorOverlay"
                Background="#AA000000"
                Visibility="Collapsed"
                CornerRadius="6"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="„Cannot retrieve the latest commit at this time“"
                           FontSize="16" Foreground="White" Margin="0 0 0 10"/>
                <Button Content="Try again..."
                        Width="150"
                        Click="Refresh_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
