<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Jnana.Workbench.Controls.NavigationHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Navigation Bar -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" HorizontalAlignment="Stretch"
                    Orientation="Horizontal" VerticalAlignment="Top">
            <FontIcon x:Name="BackButton" FontFamily="Segoe Fluent Icons" Glyph="&#xE7F8;"/>
            <FontIcon x:Name="ForwardButton" FontFamily="Segoe Fluent Icons" Glyph="&#xE7F7;"/>
            <FontIcon x:Name="ParentFolderButton" FontFamily="Segoe Fluent Icons" Glyph="&#xE838;"/>
            <BreadcrumbBar x:Name="NavigationBreadcrumbBar" BorderBrush="Aqua" BorderThickness="3">
                <!--         <FontIcon FontFamily="Segoe Fluent Icons"/>
                <FontIcon x:Name="BackButton" Glyph="&#xE7F8;"/>
        <FontIcon Grid.Column="0" Grid.Row="1" Glyph="&#xE7F8;" /> -->
            </BreadcrumbBar>
            <FontIcon x:Name="RefreshButton" FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;"/>
        </StackPanel>
        <Border Grid.Column="0" Grid.Row="1">
            <TreeView
                CanDragItems="True" AllowDrop="True">
                <!-- Tree View Items come here: Local Packages, NuGet Packages, Desktop-Folder -->
            </TreeView>
        </Border>
        <Border Grid.Column="1" Grid.Row="1" CornerRadius="32" Margin="12">
            <!--<controls:AttachDropShadow BlurRadius="16" ShadowOpacity="0.35" OffsetX="0" OffsetY="4"> -->
            <!-- TODO: Implement navigation host -->
            <!-- <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden"/> -->
            <ContentPresenter x:Name="ContentPresenter" />
        </Border>
        <VariableSizedWrapGrid Grid.Column="2" Grid.Row="1">
            <ContentPresenter x:Name="SideBarPresenter" />
        </VariableSizedWrapGrid>
        <!--<Border Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
                BorderThickness="3" CornerRadius="32" Margin="12" >
            -->
        <!--<controls:DropShadowPanel BlurRadius="16" ShadowOpacity="0.35" OffsetX="0" OffsetY="4"> -->
        <!--
                <ContentPresenter x:Name="SideBarPresenter" />
        </Border>-->
    </Grid>
</UserControl>