<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Jnana.Workbench.Controls.NavigationHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="using:Jnana.Workbench.Panels"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Put TreeView here, Column 0-->
        <!-- Navigation Bar -->
        <Border x:Name="NavigationBarBorder" Grid.Column="1" Grid.Row="0" Visibility="Collapsed">
            <Grid x:Name="NavigationBarGrid" CornerRadius="6" Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <AppBarButton x:Name="NavigateBackBtn" Grid.Column="0" CornerRadius="6" Icon="Back" Label="Back"/>
                <AppBarButton x:Name="NavigateForwardBtn" Grid.Column="1" CornerRadius="6" Icon="Forward" Label="Forward"/>
                <AppBarButton x:Name="NavigateUpBtn" Grid.Column="2" CornerRadius="6" Icon="Up" Label="Parent"/>
                <BreadcrumbBar x:Name="BreadcrumbBar" Grid.Column="3" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <AppBarButton x:Name="SubmenuBtn" Grid.Column="4" CornerRadius="6" Icon="More" Label="More..."/>
            </Grid>
        </Border>
        <!-- Page Content Presenter -->
        <Border Grid.Column="1" Grid.Row="1">
            <ContentPresenter x:Name="ContentPresenter" Grid.Column="1" Grid.Row="1"/>
        </Border>
        <!-- Page Context Sidebar -->
        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" MaxWidth="420">
            <StackPanel>
                <panels:RuntimeVersionsInfoPanel/>
                <panels:ClipboardHistoryPanel/>
            </StackPanel>
        </Border>
        <!--    <Border Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SystemControlTransparentRevealBorderBrush}"
                BorderThickness="3" CornerRadius="32" Margin="12" > -->
        <!--    <controls:DropShadowPanel BlurRadius="16" ShadowOpacity="0.35" OffsetX="0" OffsetY="4"> -->
    </Grid>
</UserControl>
