<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jnana.Workbench.Controls.FloatingStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jnana.Workbench.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Jnana.Workbench.ViewModels"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:StatusBarViewModel />
    </UserControl.DataContext>

    <Grid Background="{ThemeResource JnanaStatusBarBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: AREA ICON -->
        <StackPanel Orientation="Horizontal">
            <!-- Chevron -->
            <!--<FontIcon Glyph="{x:Bind CurrentAreaIcon}" />-->
            <FontIcon Glyph="&#xE70D;" Tapped="OnAreaMenuTapped"/>
            <!-- Chevron -->
        </StackPanel>


        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
            <FontIcon FontSize="18" Glyph="&#xE80F;" Foreground="{ThemeResource JnanaAccentBrush}" Margin="0,0,8,0"/>
        </StackPanel>

        <!-- CENTER: READY. PROMPT -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="12,0">
            <TextBlock Text="READY"
                       FontFamily="Consolas"
                       FontSize="14"
                       Foreground="{ThemeResource JnanaStatusTextBrush}"
                       Margin="0,0,2,0"/>

            <!-- Blinking Dot -->
            <TextBlock Text="."
                       FontFamily="Consolas"
                       FontSize="14"
                       Foreground="{ThemeResource JnanaStatusTextBrush}">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0"
                                                 Duration="0:0:1.2"
                                                 AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </StackPanel>

        <!-- RIGHT: SYSTEM INDICATORS -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Margin="0,0,12,0">

            <!-- CPU -->
            <StackPanel Orientation="Horizontal">
                <FontIcon Glyph="&#xE9A9;" FontSize="14" Margin="0,0,4,0"/>
                <TextBlock Text="{x:Bind CPUUsage, Mode=OneWay}" FontSize="12"/>
            </StackPanel>

            <!-- RAM -->
            <StackPanel Orientation="Horizontal">
                <FontIcon Glyph="&#xEBD8;" FontSize="14" Margin="0,0,4,0"/>
                <TextBlock Text="{x:Bind RAMUsage, Mode=OneWay}" FontSize="12"/>
            </StackPanel>

            <!-- NET -->
            <StackPanel Orientation="Horizontal">
                <FontIcon Glyph="&#xE839;" FontSize="14" Margin="0,0,4,0"/>
                <TextBlock Text="{x:Bind NetUsage, Mode=OneWay}" FontSize="12"/>
            </StackPanel>

            <!-- DISK -->
            <StackPanel Orientation="Horizontal">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" Margin="0,0,4,0"/>
                <TextBlock Text="{x:Bind DiskUsage, Mode=OneWay}" FontSize="12"/>
            </StackPanel>

            <!-- SYS GRIP -->
            <FontIcon Glyph="&#xE784;" FontSize="14" Opacity="0.6"/>
        </StackPanel>
    </Grid>

</UserControl>
