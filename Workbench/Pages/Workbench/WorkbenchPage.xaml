<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jnana.Workbench.Pages.Workbench.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jnana.Workbench.Pages"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:comp="using:Jnana.Workbench.Components"

    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0"
      Height="32"
      Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
      CornerRadius="4"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Padding="4,0,4,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Minimize Style="{StaticResource LonghornTitleBarButtonStyle}" -->
                <Button x:Name="BtnMinimize" Tag="Minimize">
                    <Path Data="M0,0 L10,0" StrokeThickness="2"/>
                </Button>

                <!-- Maximize Style="{StaticResource LonghornTitleBarButtonStyle}" -->
                <Button x:Name="BtnMaximize" Tag="Maximize">
                    <Path Data="M0,0 L10,0 L10,10 L0,10 Z" StrokeThickness="2"/>
                </Button>

                <!-- Close Style="{StaticResource LonghornTitleBarButtonStyle}" -->
                <Button x:Name="BtnClose" Tag="Close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="2"/>
                </Button>
            </StackPanel>
        </Grid>

        <!--
        TitleBar                         
        
        https://github.com/CommunityToolkit/Labs-Windows/discussions/454 
        https://learn.microsoft.com/en-us/dotnet/api/communitytoolkit.winui.ui.titlebarextensions?view=win-comm-toolkit-dotnet-7.0
        
        see also: TitleBarExtensions Class - `CommunityToolkit.WinUI.UI v7.0.3`
        -->
        <!--AnimatedIcon.State=""-->
        <TitleBar Grid.Row="1" IsBackButtonVisible="{x:Bind ShowBackButtonSetting, Mode=OneWay}"
                  Subtitle="{x:Bind SubtitleText, Mode=OneWay}" Title="{x:Bind TitleText, Mode=OneWay}" >
            <!-- TODO: IconSource=""-->
            <!-- TODO:  AutoConfigureCustomTitleBar="False"
                        IsBackButtonVisible="{x:Bind ShowBackButtonSetting, Mode=OneWay}"
                        IsPaneButtonVisible="{x:Bind ShowPaneButtonSetting, Mode=OneWay}"
                        Subtitle="{x:Bind SubtitleText, Mode=OneWay}" -->
            <!--<TitleBar.Icon> <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/AppTitleBarIcon.png" /> </TitleBar.Icon>-->
        </TitleBar>

        <!-- QuickLaunchBar -->
        <comp:QuickLaunchBar x:Name="LaunchBar" Grid.Row="2"/>

        <!-- Workbench Content -->
        <Grid x:Name="WorkbenchContent" Grid.Row="3" Background="Transparent">
            <TextBlock Text="Workbench"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="32"
                       FontWeight="SemiBold" />

            <ItemsRepeater ItemsSource="{x:Bind Tiles}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MaximumRowsOrColumns="2"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </Grid>
    </Grid>
</Page>
