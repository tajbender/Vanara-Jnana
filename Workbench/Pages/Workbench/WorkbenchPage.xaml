            <Frame x:Name="WorkbenchContentFrame" />
            <!--<StackPanel Orientation="Horizontal">
                <TextBlock Text="Jñāna workbench" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Border BorderThickness="3">
                    <ctrls:VanaraReleasePanel />
                </Border>
            </StackPanel>-->
        </Grid>
        <!-- Tool Sidebar Content -->
