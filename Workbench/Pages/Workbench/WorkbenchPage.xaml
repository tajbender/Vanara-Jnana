<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jnana.Workbench.Pages.Workbench.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jnana.Workbench.Pages"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:comp="using:Jnana.Workbench.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TitleBar                         
               https://github.com/CommunityToolkit/Labs-Windows/discussions/454 
               https://learn.microsoft.com/en-us/dotnet/api/communitytoolkit.winui.ui.titlebarextensions?view=win-comm-toolkit-dotnet-7.0
        see also: TitleBarExtensions Class - `CommunityToolkit.WinUI.UI v7.0.3` -->
        <TitleBar Grid.Row="0" Grid.ColumnSpan="2"
                  IsBackButtonVisible="{x:Bind IsBackButtonVisible, Mode=OneWay}"
                  IsBackButtonEnabled="{x:Bind IsBackButtonEnabled, Mode=OneWay}"
                  Subtitle="{x:Bind SubtitleText, Mode=OneWay}" 
                  Title="{x:Bind TitleText, Mode=OneWay}" >
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Icons/vanara.icon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- QuickLaunchBar -->
        <comp:QuickLaunchBar x:Name="LaunchBar" Grid.Column="0" Grid.Row="1" VerticalAlignment="Stretch"/>

        <!-- Workbench Content -->
        <Grid x:Name="WorkbenchContent" Grid.Column="1" Grid.Row="1" Background="Transparent">
            <StackPanel>
                <TextBlock Text="Vanara Jnana Workbench"
                       FontSize="32"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
                <Border BorderThickness="3">
                    <!--<TreeView x:Name="WorkbenchTreeView"
                          ItemsSource="{x:Bind NugetItems}"
                          SelectionMode="Single"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    -->
                    <!--<TreeView.ItemTemplate>
                        <DataTemplate x:DataType="local:WorkbenchItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>-->
                    <!--
                </TreeView>-->
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
