<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jnana.Workbench.Components.QuickLaunchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jnana.Workbench.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical" Padding="8" Spacing="8">

        <Button Click="OnWorkbenchClick" CornerRadius="6">
            <StackPanel Orientation="Vertical">
                <FontIcon Glyph="&#xEC7A;" />
                <TextBlock Text="Workbench" TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Button>

        <Button Click="OnNuGetsClick" CornerRadius="6">
            <StackPanel Orientation="Vertical">
                <FontIcon Glyph="&#xEC7A;" />
                <TextBlock Text="NuGets" TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Button>

        <Button Click="OnGitHubClick" CornerRadius="6">
            <StackPanel Orientation="Vertical">
                <FontIcon Glyph="&#xEC7A;" />
                <TextBlock Text="GitHub Client" TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Button>

        <!-- Click="OnDisassemblyClick"  -->
        <Button CornerRadius="6">
            <StackPanel Orientation="Vertical">
                <FontIcon Glyph="&#xEC7A;" />
                <TextBlock Text="Disassemblies" TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Button>

        <Button Click="OnSamplesClick" CornerRadius="6">
            <StackPanel Orientation="Vertical">
                <FontIcon Glyph="&#xEC7A;" />
                <TextBlock Text="Samples" TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Button>

        <Button Click="OnToolsAndUtilitiesClick" CornerRadius="6" >
            <StackPanel Orientation="Vertical">
                <FontIcon Glyph="&#xEC7A;" />
                <TextBlock Text="Tools &amp; Utilities" TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Button>

        <Button Click="OnSysInfoClick" CornerRadius="6">
            <StackPanel Orientation="Vertical">
                <FontIcon Glyph="&#xEC7A;" />
                <TextBlock Text="System Information Summary" TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </Button>

        <Grid x:Name="FloatingBar"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              CornerRadius="8"
              HorizontalAlignment="Left"
              Margin="0,8,8,0"
              Opacity="0.95"
              Padding="12,6"
              VerticalAlignment="Bottom">
            <StackPanel Orientation="Vertical" Spacing="12">
                <FontIcon Glyph="&#xE7F8;" />
                <!-- GPU -->
                <!--<TextBlock Text="{x:Bind ViewModel.GpuName}" />
                <TextBlock Text="{x:Bind ViewModel.GpuLoad, StringFormat='{}{0}%'}" />-->
                <FontIcon Glyph="&#xE9D9;" />
                <!-- RAM -->
                <!--<TextBlock Text="{x:Bind ViewModel.RamUsage}" />-->
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
