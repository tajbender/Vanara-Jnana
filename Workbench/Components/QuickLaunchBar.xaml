<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jnana.Workbench.Components.QuickLaunchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jnana.Workbench.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<StackPanel Orientation="Vertical" Padding="8" Spacing="8">

		<Button Click="OnWorkbenchClick" CornerRadius="6" Width="128">
			<StackPanel Orientation="Vertical">
				<FontIcon Glyph="&#xEC7A;" />
				<TextBlock Text="Workbench" HorizontalTextAlignment="Center" TextWrapping="WrapWholeWords"/>
			</StackPanel>
		</Button>

		<Button Click="OnNuGetsClick" CornerRadius="6" Width="128">
			<StackPanel Orientation="Vertical">
				<FontIcon Glyph="&#xEC7A;" />
				<TextBlock Text="NuGets" HorizontalTextAlignment="Center" TextWrapping="WrapWholeWords"/>
			</StackPanel>
		</Button>

		<Button Click="OnGitHubClick" CornerRadius="6" Width="128">
			<StackPanel Orientation="Vertical">
				<FontIcon Glyph="&#xEC7A;" />
				<TextBlock Text="GitHub Client" HorizontalTextAlignment="Center" TextWrapping="WrapWholeWords"/>
			</StackPanel>
		</Button>

		<!-- Click="OnDisassemblyClick"  -->
		<Button CornerRadius="6" Width="128">
			<StackPanel Orientation="Vertical">
				<FontIcon Glyph="&#xEC7A;" />
				<TextBlock Text="Disassemblies" HorizontalTextAlignment="Center" TextWrapping="WrapWholeWords"/>
			</StackPanel>
		</Button>

		<Button Click="OnSamplesClick" CornerRadius="6" Width="128">
			<StackPanel Orientation="Vertical">
				<FontIcon Glyph="&#xEC7A;" />
				<TextBlock Text="Vanara Science Labs" HorizontalTextAlignment="Center" TextWrapping="WrapWholeWords"/>
			</StackPanel>
		</Button>

		<Button Click="OnToolsAndUtilitiesClick" CornerRadius="6" Width="128">
			<StackPanel Orientation="Vertical">
				<FontIcon Glyph="&#xEC7A;" />
				<TextBlock Text="Tools &amp; Utilities" HorizontalTextAlignment="Center" TextWrapping="WrapWholeWords" />
			</StackPanel>
		</Button>

		<Button Click="OnSysInfoClick" CornerRadius="6" Width="128">
			<StackPanel Orientation="Vertical">
				<FontIcon Glyph="&#xEC7A;" />
				<TextBlock Text="System Information Summary" HorizontalTextAlignment="Center" TextWrapping="WrapWholeWords"/>
			</StackPanel>
		</Button>

		<Grid x:Name="FloatingBar"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              CornerRadius="8"
              HorizontalAlignment="Stretch"
              Margin="0,8,8,0"
              Opacity="0.95"
              Padding="12,6"
              VerticalAlignment="Bottom">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<FontIcon Grid.Column="0" Glyph="&#xE7F8;"/>
			<FontIcon Grid.Column="1" Glyph="&#xE9D9;"/>
			<FontIcon Grid.Column="2" Glyph="&#xE9D9;"/>

			<TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="CPU Usage" />
			<TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="Gfx Acceleration" />
			<TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="RAM Usage" />

			<!-- GPU -->
			<!--<TextBlock Text="{x:Bind ViewModel.GpuName}" />
                <TextBlock Text="{x:Bind ViewModel.GpuLoad, StringFormat='{}{0}%'}" />-->
			<!-- RAM -->
			<!--<TextBlock Text="{x:Bind ViewModel.RamUsage}" />-->
		</Grid>
	</StackPanel>
</UserControl>
