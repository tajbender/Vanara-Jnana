<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jnana.Workbench.Components.QuickLaunchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jnana.Workbench.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal"
                Spacing="8"
                Padding="8">

        <Button Content="Workbench"
                Click="OnWorkbenchClick" />

        <Button Content="GitHub"
                Click="OnGitHubClick" />

        <Button Content="NuGets"
                Click="OnNuGetsClick" />

        <Button Content="Samples"
                Click="OnSamplesClick" />

        <Button Content="Tools &amp; Utilities"
                Click="OnToolsAndUtilitiesClick" />

        <Button Content="SysInfo"
                Click="OnSysInfoClick" />

    </StackPanel>
</UserControl>
