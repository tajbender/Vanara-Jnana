<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassicSamplesBrowser.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassicSamplesBrowser.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid BorderThickness="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="Workbench" FontSize="20"/>
            <Image Height="64" HorizontalAlignment="Right" Opacity="0.42" Source="/Assets/Vanara/Amiga-Disk.png" Stretch="Uniform" VerticalAlignment="Top"/>
        </StackPanel>
        <Border Grid.Column="1" BorderThickness="1" BorderBrush="Gray" Margin="4">
            <StackPanel>
                <Button Content="Assembly Explorer" Margin="4"/>
                <Button Content="NuGets" Margin="4"/>
                <Button Content="Utilities" Margin="4"/>
                <Button Content="Settings and Preferences" Margin="4"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
