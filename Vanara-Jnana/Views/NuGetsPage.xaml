<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jnana.Views.NuGetsPage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jnana.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid Background="#0FFFFFFF" ColumnSpacing="42" HorizontalAlignment="Stretch" Padding="15" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
            <FontIcon x:Name="IconElement" Grid.Column="0" Grid.Row="0"  Glyph="&#xE7B8;"/>
            <TextBlock Grid.Column="1" Grid.Row="0"  Text="NuGets" FontSize="20"/>
        </StackPanel>
        <!-- TextBox: Text="{x:Bind SearchQuery, Mode=TwoWay}" -->
        <!--<TextBox Grid.Column="0" Grid.Row="1" Margin="0,12,12,0" PlaceholderText="Search NuGet packages..."/>
        <TextBlock Grid.Column="1" Grid.Row="1" Margin="12,12,0,0" Opacity="0.8" Text="https://www.nuget.org/profiles/dahall"/>-->

        <Grid ColumnDefinitions="Auto,*">
            <!-- Left: Package list -->
            <!--<ItemsRepeater x:Name="PackageList" ItemsSource="{x:Bind ViewModel.Packages}">
                --><!--<DataTemplate x:DataType="models:NuGetPackage">
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <Image Source="{x:Bind Icon}" Width="32" Height="32"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Version}" Foreground="{ThemeResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>--><!--
            </ItemsRepeater>-->

            <!-- Right: Info panel -->
            <TextBox Grid.Column="1" Margin="12,0,0,0" TextWrapping="Wrap" IsReadOnly="True"
                     Text="Here come thy Bastards"/>
            <!--<Frame Grid.Column="1" x:Name="InfoPanel" Content="{x:Bind ViewModel.SelectedPackageDetail, Mode=OneWay}"/>-->
        </Grid>


    </Grid>
</Page>
