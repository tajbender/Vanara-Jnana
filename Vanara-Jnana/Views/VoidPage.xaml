<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jnana.Views.VoidPage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jnana.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:Jnana.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid Background="#0FFFFFFF" ColumnSpacing="42" HorizontalAlignment="Stretch" Padding="15" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" -->
        <ScrollViewer x:Name="NuGetsScrollViewer" Grid.Column="0" BorderBrush="DarkGray" BorderThickness="3" CornerRadius="8">
            <StackPanel Margin="12" Spacing="8" >
                <StackPanel>
                    <TextBlock FontSize="32" Style="{StaticResource CaptionTextBlockStyle}" Text="NuGets"/>
                    <TextBlock FontSize="13" Opacity="0.8" Style="{ThemeResource CaptionTextBlockStyle}" Text="Packages Releases."/>
                    <TextBlock FontSize="13" Opacity="0.8" Style="{ThemeResource CaptionTextBlockStyle}" Text="Latest Version: TODO: Instert latest Version"/>
                    <AppBarSeparator Margin="0,8"/>
                </StackPanel>
                <Border BorderBrush="DarkGray" BorderThickness="3" CornerRadius="8" Padding="12">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.dummyNugetItems}" MinHeight="127">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemHeight="42" MinItemWidth="280" Orientation="Vertical"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Border>
                <controls:SettingsCard 
                               ActionIconToolTip="Visit official NuGets page in new Web Browser Window."
                               Description="Visit official NuGets page."
                               Header="Visit NuGets"
                               
                               IsClickEnabled="True"
                               IsEnabled="true" />
                <!--<controls:SettingsCard ActionIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                               ActionIconToolTip="Open in new window"
                               Click="OnCardClicked"
                               Description="Visit official NuGets page."
                               Header="Customizing the ActionIcon"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE774;}"
                               IsClickEnabled="True"
                               IsEnabled="{x:Bind IsCardEnabled, Mode=OneWay}" />-->
                <!-- TODO: Icon -->
                <!--  <toolkit:SettingsCard Description="Choose between Light, Dark or System default" Header="Theme"> -->
                <!--   SelectedItem="{x:Bind ViewModel.AppTheme, Mode=TwoWay}" -->
                <!--   <ComboBox> <x:String>Light</x:String> <x:String>Dark</x:String> <x:String>System</x:String> </ComboBox>
                      </toolkit:SettingsCard> -->
                <!-- <toolkit:ToggleSwitchSetting Description="Enable Mica background for supported windows" Header="Use Mica" IsOn="{x:Bind ViewModel.UseMica, Mode=TwoWay}" />
                     <toolkit:ToggleSwitchSetting Description="Allow anonymous usage data" Header="Telemetry" IsOn="{x:Bind ViewModel.AllowTelemetry, Mode=TwoWay}" /> -->
                <!-- </StackPanel> </ScrollViewer>-->
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="GitHubScrollViewer" Grid.Column="1" BorderBrush="DarkGray" BorderThickness="3" CornerRadius="8">
            <StackPanel Margin="12" Spacing="8">
                <TextBlock FontSize="32" Style="{StaticResource CaptionTextBlockStyle}" Text="GitHub"/>
                <TextBlock FontSize="13" Opacity="0.8" Style="{ThemeResource CaptionTextBlockStyle}" Text="Vanara on GitHub."/>
                <AppBarSeparator Margin="0,8"/>
                <Button Content="github.com/dahall/Vanara" />
                <Button Content="github.com/dahall/Vanara/issues" />
                <Button Content="github.com/dahall/Vanara/pulls" />
                <Button Content="github.com/dahall/Vanara/discussions" />
                <Button Content="github.com/dahall/Vanara/releases" />
                <Button Content="github.com/dahall/Vanara/license" />
            </StackPanel>
        </ScrollViewer>

        <!--<ScrollViewer x:Name="GitHubScrollViewer" Grid.Column="1" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="DarkGray" BorderThickness="3" CornerRadius="8" IsTabStop="False">
            <StackPanel Margin="12" Spacing="8">
                <TextBlock FontSize="32" Style="{StaticResource CaptionTextBlockStyle}" Text="GitHub"/>
                <TextBlock FontSize="13" Opacity="0.8" Style="{ThemeResource CaptionTextBlockStyle}" Text="Vanara on GitHub."/>
                <AppBarSeparator Margin="0,8"/>
                <Border BorderBrush="DarkGray" BorderThickness="3" CornerRadius="8" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <WebView2 x:Name="GitHubWebView2" DefaultBackgroundColor="Transparent" MinHeight="128" MinWidth="256" Source="https://google.com" IsHitTestVisible="False"/>
                </Border>
            </StackPanel>
        </ScrollViewer>-->

        <ScrollViewer x:Name="SamplesScrollViewer" Grid.Column="2" BorderBrush="DarkGray" BorderThickness="3" CornerRadius="8">
            <StackPanel Margin="12" Spacing="8">
                <TextBlock FontSize="32" Style="{StaticResource CaptionTextBlockStyle}" Text="Samples"/>
                <TextBlock FontSize="13" Opacity="0.8" Style="{ThemeResource CaptionTextBlockStyle}" Text="Examples and Unit Tests."/>
                <AppBarSeparator Margin="0,8"/>
                <!--<ItemsRepeater ItemsSource="{x:Bind ViewModel.SamplesItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemHeight="42" MinItemWidth="280" Orientation="Vertical"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>-->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
