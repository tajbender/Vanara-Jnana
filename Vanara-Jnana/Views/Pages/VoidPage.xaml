                                              ItemsStretch="{x:Bind local:StaggeredLayoutSample.ConvertStringToStaggeredLayoutItemsStretch(ItemsStretchProperty), Mode=OneWay}"
                                              RowSpacing="{x:Bind RowSpacing, Mode=OneWay}" />
                </muxc:ItemsRepeater.Layout>-->
            </muxc:ItemsRepeater>
