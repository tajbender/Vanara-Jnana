<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jnana.Views.SettingsPage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jnana.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <ScrollViewer BorderThickness="3">
        <StackPanel Spacing="16" Padding="24" >
            <!-- TODO: Icon -->
            <toolkit:SettingsCard Description="Choose between Light, Dark or System default" Header="Theme">
                <!-- SelectedItem="{x:Bind ViewModel.AppTheme, Mode=TwoWay}" -->
                <ComboBox >
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                    <x:String>High Contrast</x:String>
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander Header="Advanced Examples">
                <toolkit:SettingsCard Description="Allow anonymous usage data" Header="Telemetry" />
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
