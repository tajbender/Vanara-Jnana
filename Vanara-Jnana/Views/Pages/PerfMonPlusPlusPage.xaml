<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vanara_Jnana.Views.Pages.PerfMonPlusPlusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vanara_Jnana.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Vanara_Jnana.ViewModels"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="260,*,320">

        <!-- Left: Categories -->
        <ListView x:Name="CategoryList"
                  ItemsSource="{x:Bind ViewModel.Categories}"
                  SelectionChanged="CategoryList_SelectionChanged"
                  Margin="8"
                  />

        <!-- Middle: Counter List -->
        <ListView x:Name="CounterList"
                  Grid.Column="1"
                  ItemsSource="{x:Bind ViewModel.Counters}"
                  Margin="8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CounterInfo">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind Name}" Width="240"/>
                        <TextBlock Text="{x:Bind InstanceName}" Width="120"/>
                        <TextBlock Text="{x:Bind CurrentValue}" Width="80"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Right: Details -->
        <StackPanel Grid.Column="2" Margin="8" Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.SelectedCounter.Name}" 
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{x:Bind ViewModel.SelectedCounter.Description}" 
                       TextWrapping="Wrap"/>

            <!-- Placeholder for future chart -->
            <Border Height="160" Background="#222" CornerRadius="6">
                <TextBlock Text="Live Chart (coming soon)" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <Button Content="Pin to Statusbar"
                    Command="{x:Bind ViewModel.PinToStatusbarCommand}"/>
        </StackPanel>

    </Grid>

</Page>
