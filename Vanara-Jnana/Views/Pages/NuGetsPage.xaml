<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jnana.Views.Pages.NuGetsPage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jnana.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Jnana.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Search Bar -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <AutoSuggestBox
                x:Name="SearchBox"
                Width="300"
                PlaceholderText="NuGet-Pakete suchen..." />

            <Button Content="Aktualisieren" />
        </StackPanel>

        <!-- Package List -->
        <ScrollViewer Grid.Row="1">
            <ItemsRepeater x:Name="PackageRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        MinColumnSpacing="12"
                        MinRowSpacing="12"
                        MinItemWidth="320" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

    </Grid>
        <!-- Package list --><!--
        <ScrollViewer x:Name="PackageListScrollViewer" Grid.Column="0" BorderBrush="DarkGray" BorderThickness="3" CornerRadius="8">
            <TreeView x:Name="PackageTreeView" Grid.Column="0" ItemsSource="{x:Bind ViewModel.Packages}" SelectionChanged="PackageTreeView_SelectionChanged">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:PackageVersionInfo">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Version}" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </ScrollViewer>

        --><!-- Right pane info panel --><!--
        <Border Grid.Column="1" Background="#0FFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="8">
            <Grid DataContext="{x:Bind ViewModel.PackageDetailViewModel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <Image Source="{Binding Icon}" Width="64" Height="64"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Id}" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text="{Binding Version}" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" BorderBrush="DarkGray" BorderThickness="1" CornerRadius="4">
                    <tkcontrols:MarkdownTextBlock FontSize="14" Margin="0,12,0,0" Text="{Binding Readme}"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="12,12">
                    <Button Content="Dependencies..." IsEnabled="False"/>
                    <Button Content="Assemblies..." IsEnabled="False"/>
                    <Button Content="License..." IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>-->
</Page>
