<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jnana.Views.UtilitiesPage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jnana.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Orientation="Vertical">
            <toolkit:Ribbon>
                <toolkit:RibbonGroup>
                    <Button>
                        <StackPanel>
                            <FontIcon Glyph="&#xE104;" FontSize="20"/>
                            <TextBlock Text="Cut" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </toolkit:RibbonGroup>
                <toolkit:RibbonGroup>
                    <Button>
                        <StackPanel>
                            <FontIcon Glyph="&#xE105;" FontSize="20"/>
                            <TextBlock Text="Copy" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </toolkit:RibbonGroup>
                <toolkit:RibbonGroup>
                    <Button>
                        <StackPanel>
                            <FontIcon Glyph="&#xE16C;" FontSize="20"/>
                            <TextBlock Text="Paste" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </toolkit:RibbonGroup>
            </toolkit:Ribbon>
            <TabView>
                <TabViewItem Header="File Opus">
                    <TextBlock Text="Content for File Opus" Margin="12"/>
                </TabViewItem>
                <TabViewItem Header="Editor">
                    <TextBlock Text="Content for Editors" Margin="12"/>
                </TabViewItem>
                <TabViewItem Header="ILSpy Disassembler">
                    <TextBlock Text="ILSpy Disassembler" Margin="12"/>
                </TabViewItem>
                <TabViewItem Header="SysInfo">
                    <TextBlock Text="System Information" Margin="12"/>
                </TabViewItem>
            </TabView>
        </StackPanel>
    </Grid>
</Page>
