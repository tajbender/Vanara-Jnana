<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassicSamplesBrowser.Views.StartPage"
    xmlns:controls="using:ClassicSamplesBrowser.Vanara.Controls"
    xmlns:local="using:ClassicSamplesBrowser.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

    <Grid>
        <Grid x:Name="MainContentGrid" Grid.Row="1" BorderBrush="Transparent" BorderThickness="3">
            <!-- INFO: https://learn.microsoft.com/en-us/windows/apps/develop/ui/controls/tab-view -->
            <TabView x:Name="MainTabs"
                     AddTabButtonClick="MainTabs_AddTabButtonClick"
                     Margin="7"
                     SelectionChanged="MainTabs_SelectionChanged"
                     TabWidthMode="SizeToContent">
                <!-- TODO: TabStripPlacement="Left" -->
                <!-- Optional: Header über der Tab-Leiste -->
                <TabView.TabStripHeader>
                    <TextBlock Text="Jñāna" Margin="8,8,8,16" FontSize="14" HorizontalAlignment="Left" Opacity="0.7"/>
                </TabView.TabStripHeader>
                <!-- Beispiel-Tab -->
                <TabViewItem Header="Home">
                    <Frame x:Name="HomeFrame" Content="ShellPage"/>
                </TabViewItem>
            </TabView>
        </Grid>
        <Image Grid.Row="1" HorizontalAlignment="Right" Opacity="0.3" Source="/Assets/VanaraMonkey.png" Stretch="Uniform" VerticalAlignment="Bottom" Width="96"/>
        <controls:FloatingStatusBar x:Name="StatusBar" Grid.Row="2" Height="42"/>
    </Grid>
</Page>
