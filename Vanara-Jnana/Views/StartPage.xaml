<Page
    x:Class="ClassicSamplesBrowser.Views.StartPage"
    xmlns:controls="using:ClassicSamplesBrowser.Vanara.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClassicSamplesBrowser.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d">
    <Grid Padding="32" RowSpacing="32" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" BorderThickness="3" Spacing="8">
            <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Vanara Jñāna"/>
            <TextBlock Opacity="0.8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Explore APIs, Samples, Assemblies, Tools"/>
        </StackPanel>
        <Grid x:Name="featureTiles" Grid.Row="1" BorderThickness="3" ColumnSpacing="24" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <controls:FeatureTile Grid.Row="0" Grid.Column="0" Subtitle="Browse Vanara versions" Title="NuGets"/>
            <controls:FeatureTile Grid.Row="0" Grid.Column="1" Subtitle="Source, Issues, PRs" Title="GitHub"/>
            <controls:FeatureTile Grid.Row="0" Grid.Column="2" Subtitle="Examples and tests" Title="Samples"/>
            <controls:FeatureTile Grid.Row="1" Grid.Column="0" Subtitle="APIs, resources and metadata" Title="Assemblies"/>
            <controls:FeatureTile Grid.Row="1" Grid.Column="1" Subtitle="Tools and diagnostics" Title="Utilities"/>
            <controls:FeatureTile Grid.Row="1" Grid.Column="2" Subtitle="Settings and preferences" Title="Settings"/>
        </Grid>
        <TabView Grid.Row="2" x:Name="tabView" BorderThickness="3" BorderBrush="Black"/>
        <controls:FloatingStatusBar Grid.Row="3" x:Name="statusBar"/>
    </Grid>
</Page>
