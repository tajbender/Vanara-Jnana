<Page
    x:Class="ClassicSamplesBrowser.Views.StartPage"
    xmlns:controls="using:ClassicSamplesBrowser.Vanara.Controls"
    xmlns:local="using:ClassicSamplesBrowser.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" Source="/Assets/Vanara/Vanara-64px.png"/>
                <TextBlock Grid.Column="0" Grid.Row="1" FontSize="28" FontWeight="SemiBold" Text="Vanar" />
                <TextBlock Grid.Column="1" Grid.Row="0" FontSize="28" HorizontalTextAlignment="Right" 
                           Opacity="0.5" Text="Jñān" VerticalAlignment="Bottom">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="90"/>
                        <!--<CompositeTransform Rotation="90"/>-->
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Grid.Column="1" Grid.Row="1" FontSize="28" FontWeight="SemiBold" Opacity="0.5" Text="a" Width="Auto">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <!-- Feature Tiles -->
            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Padding="12,0">
                <controls:FeatureTile Icon="&#xE71E;" Subtitle="NuGet Package Releases." Title="NuGet"/>
                <controls:FeatureTile Icon="&#xE8A5;" Subtitle="View on GitHub." Title="GitHub"/>
                <controls:FeatureTile Icon="&#xE8A5;" Subtitle="Explore Types, Members and Interfaces." Title="APIs"/>
                <controls:FeatureTile Icon="&#xE8EF;" Subtitle="View Examples." Title="Samples"/>
            </StackPanel>

            <!-- Navigation Area -->
            <TextBox Grid.Column="1" Grid.Row="1" Text="Ready."/>
        </Grid>

        <Grid x:Name="MainContentGrid" Grid.Row="1" Opacity="0.76" Padding="32" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <controls:SidebarControl Grid.Column="0" BorderBrush="Beige" BorderThickness="3" Margin="7"/>

            <Border Grid.Column="1" BorderBrush="Beige" BorderThickness="3"  Margin="7">
                <ListView></ListView>
            </Border>

            <StackPanel Grid.Column="2" Padding="32" Spacing="12" HorizontalAlignment="Left" BorderThickness="3" BorderBrush="Beige" Margin="7">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="What this tool does."/>
                <TextBlock Opacity="0.8" Text="This Explorer lets you browse Vanara APIs, inspect types, view samples, explore NuGet versions, and understand wrapper relationships. It is powered by reflection, NuGet metadata, and the Vanara test suite." TextWrapping="Wrap"/>
                <TextBlock FontWeight="SemiBold" Margin="0,12,0,0" Text="Core Features"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="• API Tree (Namespaces → Types → Members)" TextWrapping="Wrap"/>
                    <TextBlock Text="• NuGet Version Selector" TextWrapping="Wrap"/>
                    <TextBlock Text="• Sample Mapping (Unit Tests → API)" TextWrapping="Wrap"/>
                    <TextBlock Text="• Wrapper Detection (IShellItem → ShellItem)" TextWrapping="Wrap"/>
                    <TextBlock Text="• Reflection‑based Metadata" TextWrapping="Wrap"/>
                    <TextBlock Text="• TaskScheduler Integration" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <controls:FloatingStatusBar x:Name="StatusBar" Grid.Row="2" />
    </Grid>
</Page>
