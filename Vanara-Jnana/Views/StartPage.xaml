<Page
    x:Class="ClassicSamplesBrowser.Views.StartPage"
    xmlns:controls="using:ClassicSamplesBrowser.Vanara.Controls"
    xmlns:local="using:ClassicSamplesBrowser.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    CanDrag="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="54"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" Source="/Assets/Vanara/Vanara-64px.png" VerticalAlignment="Stretch"/>
                <TextBlock Grid.Column="0" Grid.Row="1" FontSize="28" FontWeight="SemiBold" Text="Vanar"/>
                <TextBlock Grid.Column="1" Grid.Row="0" FontSize="28" Opacity="0.5" Text="Jñān" >
                    <TextBlock.RenderTransform>
                        <CompositeTransform Rotation="90"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Grid.Column="1" Grid.Row="1" FontSize="28" FontWeight="SemiBold" Opacity="0.5" Text="a" Width="Auto">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-23"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <!-- Feature Tiles -->
            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Padding="12,0">
                <controls:FeatureTile Click="FeatureTile_OnClick" Icon="&#xE71E;" Subtitle="NuGet Package Releases." Title="NuGets" />
                <controls:FeatureTile Click="FeatureTile_OnClick" Icon="&#xE8A5;" Subtitle="View on GitHub." Title="GitHub"/>
                <controls:FeatureTile Click="FeatureTile_OnClick" Icon="&#xE8A5;" Subtitle="Explore Types, Members and Interfaces." Title="Inspect"/>
                <controls:FeatureTile Click="FeatureTile_OnClick" Icon="&#xE8EF;" Subtitle="View Examples." Title="Samples"/>
            </StackPanel>

            <!-- Navigation Area 51 -->
            <StackPanel Grid.Column="1" Grid.Row="1" MaxHeight="42" Orientation="Horizontal" Padding="12,0" VerticalAlignment="Stretch">
                <AppBarButton Content="Previous." />
                <AppBarButton Content="Next." />
                <AppBarSeparator/>
                <AutoSuggestBox MinWidth="256" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <AutoSuggestBox MinWidth="256" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Opacity="0.76" Padding="32" >
            <controls:SidebarControl Grid.Column="0" BorderBrush="Beige" BorderThickness="3" Margin="7" Padding="7"/>
            <Border Grid.Column="1" BorderBrush="Beige" BorderThickness="3" Margin="7" Padding="7">

                <TabView x:Name="MainTabView" Grid.Row="1" CanDragTabs="False" CanReorderTabs="False" Margin="8,0,8,8" TabWidthMode="Equal"
                         AddTabButtonClick="MainTabs_AddTabButtonClick" SelectionChanged="MainTabs_SelectionChanged" >

                    <TabView.Resources>
                        <!-- `TabViewItem` Styles -->
                        <Style TargetType="TabViewItem">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="MinWidth" Value="140"/>
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="Foreground" Value="#333"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabViewItem">
                                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="3"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <ContentPresenter Grid.Row="0" Content="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Selection Indicator -->
                                            <Border x:Name="SelectionIndicator" Grid.Row="1" Background="#0078D4" Height="3" Opacity="0"/>
                                        </Grid>

                                        <!-- TODO: Add Visual States for Normal and Selected -->
                                        <!--<VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Indicator.Opacity" Value="1"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>-->

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabView.Resources>

                    <TabView.TabStripHeader>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0">
                            <TextBlock Text="Vanara Jñāna" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                            <TextBlock Text="API Knowledge Explorer" FontSize="12" Foreground="#666" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </TabView.TabStripHeader>

                    <TabViewItem Header="Jnana">
                        <Frame x:Name="HomeFrame"/>
                    </TabViewItem>

                </TabView>
            </Border>
            <controls:SidebarControl Grid.Column="2" BorderBrush="Beige" BorderThickness="3" Margin="7" Padding="7"/>
        </Grid>
        <controls:FloatingStatusBar x:Name="StatusBar" Grid.Row="2" BorderBrush="Beige" BorderThickness="3" MinHeight="42" VerticalAlignment="Bottom" />
    </Grid>
</Page>
