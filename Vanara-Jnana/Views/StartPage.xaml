<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassicSamplesBrowser.Views.StartPage"
    xmlns:controls="using:ClassicSamplesBrowser.Vanara.Controls"
    xmlns:local="using:ClassicSamplesBrowser.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="DragArea" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Vanara Logo Area -->
            <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" FontSize="23" FontWeight="SemiBold" Text="Vanara" Padding="3,7"/>
                <Image Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" Source="/Assets/Vanara/Vanara-64px.png"/>
            </Grid>
            <!-- Feature Tiles -->
            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Padding="7,0">
                <controls:FeatureTile Click="NuGetsFeatureTile_OnClick" Icon="&#xE7B8;" Title="NuGets" Subtitle="Package Releases"/>
                <controls:FeatureTile Click="GitHubFeatureTile_OnClick" Icon="&#xE9D5;" Title="GitHub" Subtitle="Vanara on GitHub"/>
                <controls:FeatureTile Click="SamplesFeatureTile_OnClick" Icon="&#xE8F1;" Title="Samples" Subtitle="Examples and Unit Tests"/>
                <controls:FeatureTile Click="AssembliesFeatureTile_OnClick" Icon="&#xEA86;" Title="Assemblies" Subtitle="Explore Types, Members and Interfaces"/>
                <controls:FeatureTile Click="UtilitiesFeatureTile_OnClick" Icon="&#xE90F;" Title="Utilities" Subtitle="Tools, Helpers, Generators"/>
            </StackPanel>
            <!-- Navigation Area 51 -->
            <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="12,8,12,4" Padding="7" VerticalAlignment="Stretch" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPrevious" Grid.Column="0" ToolTipService.ToolTip="Previous" >
                    <FontIcon Glyph="&#xE72B;"/>
                </Button>
                <SplitButton x:Name="BtnNext" Grid.Column="1" ToolTipService.ToolTip="Next" >
                    <SplitButton.Content>
                        <FontIcon Glyph="&#xE72A;"/>
                    </SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="NuGets"/>
                            <MenuFlyoutItem Text="GitHub"/>
                            <MenuFlyoutItem Text="Samples"/>
                            <MenuFlyoutItem Text="Assemlbies"/>
                            <MenuFlyoutItem Text="Utilities"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button x:Name="BtnParent" Grid.Column="2" Height="32" Padding="0" ToolTipService.ToolTip="Parent Folder" Width="36">
                    <SymbolIcon Symbol="Up" />
                </Button>
                <Button x:Name="BtnReload" Grid.Column="3" Height="32" ToolTipService.ToolTip="Reload View..." >
                    <FontIcon Glyph="&#xE72C;"/>
                </Button>
                <Border Grid.Column="4" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Height="32" VerticalAlignment="Stretch" >
                    <BreadcrumbBar x:Name="NavBreadcrumb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemClicked="NavBreadcrumb_ItemClicked"/>
                </Border>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="5" Height="32" PlaceholderText="Share your Thoughts..." QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted" TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Grid>
        <Grid x:Name="MainContentGrid" Grid.Row="1" BorderBrush="Transparent" BorderThickness="3">
            <TabView x:Name="MainTabs"
                AddTabButtonClick="MainTabs_AddTabButtonClick"
                CanDragTabs="False"
                CanReorderTabs="False"
                SelectionChanged="MainTabs_SelectionChanged"
                TabWidthMode="SizeToContent"
                Margin="8,0,8,8">
                <!-- TODO: TabStripPlacement="Left" -->
                <!-- Optional: Header über der Tab-Leiste -->
                <TabView.TabStripHeader>
                    <TextBlock Text="Workspace" Margin="8,8,8,16" FontSize="14" Opacity="0.7"/>
                </TabView.TabStripHeader>
                <!-- Beispiel-Tab -->
                <TabViewItem Header="Home">
                    <Frame x:Name="HomeFrame"/>
                </TabViewItem>
            </TabView>
        </Grid>
        <!-- <Image HorizontalAlignment="Right" Opacity="0.3" Source="/Assets/VanaraMonkey.png" Stretch="Uniform" VerticalAlignment="Bottom" Width="96"/> -->
        <controls:FloatingStatusBar x:Name="StatusBar" Grid.Row="2" Height="42"/>
    </Grid>
</Page>
