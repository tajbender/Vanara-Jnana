<Page
    x:Class="ClassicSamplesBrowser.Views.StartPage"
    xmlns:controls="using:ClassicSamplesBrowser.Vanara.Controls"
    xmlns:local="using:ClassicSamplesBrowser.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Logo -->
                <ColumnDefinition Width="Auto"/>
                <!-- Feature Tiles -->
                <ColumnDefinition Width="*"/>
                <!-- Filler, stretch -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Logo + Tiles -->
                <RowDefinition Height="Auto"/>
                <!-- Navigation -->
            </Grid.RowDefinitions>

            <!-- Vanara Logo Area 51 -->
            <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="54"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Source="/Assets/Vanara/Vanara-64px.png"/>

                <TextBlock Grid.Column="0" Grid.Row="1" FontSize="28" FontWeight="SemiBold" Text="Vanar"/>
                <TextBlock Grid.Column="1" Grid.Row="0" FontSize="28" Opacity="0.5" Text="Jñān">
                    <TextBlock.RenderTransform>
                        <CompositeTransform Rotation="90"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock Grid.Column="1" Grid.Row="1" FontSize="28" FontWeight="SemiBold" Opacity="0.5" Text="a">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-23"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <!-- Feature Tiles Area 51 -->
            <StackPanel Grid.Column="1"
                Grid.Row="0"
                Orientation="Horizontal"
                Padding="12,0">
                <controls:FeatureTile Click="FeatureTile_OnClick" Icon="&#xE7B8;" Subtitle="Package Releases." Title="NuGets" />
                <controls:FeatureTile Click="FeatureTile_OnClick" Icon="&#xE9D5;" Subtitle="View on GitHub." Title="GitHub"/>
                <controls:FeatureTile Click="FeatureTile_OnClick" Icon="&#xE721;" Subtitle="Explore Types, Members and Interfaces." Title="Inspect"/>
                <controls:FeatureTile Click="FeatureTile_OnClick" Icon="&#xE8F1;" Subtitle="Visit Showcase." Title="Samples"/>
            </StackPanel>

            <!-- Navigation Area 51 -->
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,8,12,4" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPrevious" Grid.Column="0" Height="32" Padding="0" ToolTipService.ToolTip="Previous" Width="36">
                    <FontIcon Glyph="&#xE72B;"/>
                </Button>

                <SplitButton x:Name="BtnNext" Grid.Column="1" Height="32" Margin="6,0" ToolTipService.ToolTip="Next" Width="48">
                    <SplitButton.Content>
                        <FontIcon Glyph="&#xE72A;"/>
                    </SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Forward 1"/>
                            <MenuFlyoutItem Text="Forward 2"/>
                            <MenuFlyoutItem Text="Forward 3"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <Border Grid.Column="2" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="1" 
                        CornerRadius="4" Height="32" Margin="12,0" Padding="8,0" VerticalAlignment="Center" >
                    <BreadcrumbBar x:Name="NavBreadcrumb" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemClicked="NavBreadcrumb_ItemClicked"/>
                </Border>

                <AutoSuggestBox x:Name="SearchBox" Grid.Column="3" Height="32" PlaceholderText="Search"
                        QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted" TextChanged="SearchBox_TextChanged" Width="260" />
            </Grid>
        </Grid>

        <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Opacity="0.76" Padding="32" >

            <controls:SidebarControl x:Name="Sidebar" Margin="7" Padding="7"/>

            <Border x:Name="TabViewBorder" Grid.Column="1" Margin="7" Padding="7">
                <TabView x:Name="MainTabView" Grid.Row="1" CanDragTabs="False" Margin="8,0,8,8"
                         AddTabButtonClick="MainTabs_AddTabButtonClick" 
                         SelectionChanged="MainTabs_SelectionChanged" >
                    <TabView.Resources>
                        <Style TargetType="TabViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#333"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="MinWidth" Value="140"/>
                            <Setter Property="Padding" Value="16,8"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabViewItem">

                                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="3"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <ContentPresenter Grid.Row="0" Content="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Selection Indicator -->
                                            <Border x:Name="Indicator" Grid.Row="1" Background="#0078D4" Height="3" Opacity="0"/>
                                        </Grid>

                                        <!--<VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="RootGrid.Background" Value="#F2F2F2"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Indicator.Opacity" Value="1"/>
                                                        <Setter Target="RootGrid.Background" Value="#FFFFFF"/>
                                                        <Setter Property="Foreground" Value="#000"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>-->

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabView.Resources>

                    <TabView.TabStripHeader>
                        <StackPanel Orientation="Vertical" Spacing="8" Margin="12,0">
                            <TextBlock Text="Jñāna" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                            <TextBlock Text="v 5.5.5" FontSize="12" Foreground="#666" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </TabView.TabStripHeader>

                    <TabViewItem>
                        <TabViewItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" />
                                <!-- Symbol: Page -->
                                <TextBlock Text="Home"/>
                            </StackPanel>
                        </TabViewItem.Header>

                        <Frame x:Name="HomeFrame"/>
                    </TabViewItem>

                </TabView>
            </Border>
            <controls:SidebarControl Grid.Column="2" BorderBrush="Beige" BorderThickness="3" Margin="7" Padding="7" Visibility="Collapsed"/>
        </Grid>

        <controls:FloatingStatusBar x:Name="StatusBar" Grid.Row="2" BorderBrush="Beige" BorderThickness="3" MinHeight="42" VerticalAlignment="Bottom" />
    </Grid>
</Page>
