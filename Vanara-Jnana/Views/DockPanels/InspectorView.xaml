<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Jnana.Views.DockPanels.InspectorView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jnana.Views.DockPanels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- TODO: Load frame content into page -->
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="Inspector Panel:"/>
        <Border Grid.Row="1" Background="{ThemeResource SystemControlBackgroundAltHighBrush}" CornerRadius="4" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
            <ScrollViewer>
                <StackPanel x:Name="InspectorPanel" Padding="12" Spacing="12"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
