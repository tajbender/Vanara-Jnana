<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassicSamplesBrowser.Vanara.Controls.SidebarControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClassicSamplesBrowser.Vanara.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d">

    <!-- TODO Use RelativePanel to allow for better resizing and rearrangement of the sidebar and content areas. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="54" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="MainContent" Grid.Column="0" Spacing="4" VerticalAlignment="Stretch">
            <AppBarButton Content="NuGets" Icon="Library"/>
            <AppBarButton Content="GitHub" Icon="Library"/>
            <AppBarSeparator />
            <AppBarButton Content="Samples" Icon="Library"/>
            <AppBarSeparator />
            <AppBarButton Content="Settings" Icon="Setting"/>
        </StackPanel>
    </Grid>
</UserControl>
