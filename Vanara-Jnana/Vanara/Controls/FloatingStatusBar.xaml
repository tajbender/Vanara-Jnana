<UserControl
    x:Class="ClassicSamplesBrowser.Vanara.Controls.FloatingStatusBar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClassicSamplesBrowser.Vanara.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d">

    <FrameworkElement.Height>56</FrameworkElement.Height>

    <Grid x:Name="ControlRoot"
          CornerRadius="8"
          Padding="12,6"
          Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="3"
          MinHeight="42"
          Translation="0,20,0">

        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon x:Name="IconElement"
                      Glyph="&#xE946;"
                      FontSize="14"
                      Opacity="0.8"/>
            <TextBlock x:Name="MessageElement"
                       Text="Ready."
                       FontSize="14"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
