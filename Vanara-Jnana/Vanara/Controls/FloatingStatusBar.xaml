<UserControl
    x:Class="Jnana.Vanara.Controls.FloatingStatusBar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jnana.Vanara.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    d:DataContext="{d:DesignInstance Type=local:FloatingStatusBar}"
    mc:Ignorable="d">

    <!--<FrameworkElement.MinHeight>80</FrameworkElement.MinHeight>-->

    <Grid 
      Background="{ThemeResource LayerFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1" HorizontalAlignment="Stretch"
      CornerRadius="6"
      Height="Auto"
      Margin="12"
      Padding="12,0"
      VerticalAlignment="Stretch">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: System Live Info -->
        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="16">
            <TextBlock Text="CPU:" FontWeight="SemiBold"/>
            <!--<TextBlock Text="{x:Bind ViewModel.CpuLoadPercent}"/>-->
            <TextBlock Text="RAM:" FontWeight="SemiBold" Margin="12,0,0,0"/>
            <!--<TextBlock Text="{x:Bind ViewModel.MemoryWorkingSetMB}"/>-->
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="16">
            <TextBlock Text="Disk:" FontWeight="SemiBold"/>
            <!--<TextBlock Text="{x:Bind ViewModel.CpuLoadPercent}"/>-->
            <TextBlock Text="Network:" FontWeight="SemiBold" Margin="12,0,0,0"/>
            <!--<TextBlock Text="{x:Bind ViewModel.MemoryWorkingSetMB}"/>-->
        </StackPanel>
        <!--<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <Button Content="Snapshot"/>
            -->
        <!--Command="{x:Bind ViewModel.TakeSnapshotCommand}" />-->
        <!--
            <Button Content="Refresh"/>
            -->
        <!--Command="{x:Bind ViewModel.RefreshSysInfoCommand}" />-->
        <!--
        </StackPanel>-->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="16">
            <TextBlock Text="Workbench" FontWeight="SemiBold"/>
            <!--<TextBlock Text="{x:Bind ViewModel.WorkbenchVersion}"/>-->
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="16">
            <TextBlock Text="Workbench" FontWeight="SemiBold"/>
            <!--<TextBlock Text="{x:Bind ViewModel.WorkbenchVersion}"/>-->
        </StackPanel>
    </Grid>
</UserControl>
