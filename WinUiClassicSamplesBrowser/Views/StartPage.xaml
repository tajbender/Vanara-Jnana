<Page
    x:Class="ClassicSamplesBrowser.Views.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:ClassicSamplesBrowser.Views"
    xmlns:controls="using:ClassicSamplesBrowser.Vanara.Controls">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DirectXHeaderGrid" Grid.Row="0" Background="#3A2F5F" MaxHeight="192" Opacity="0.76">
            <Grid.ColumnDefinitions>
                <ColumnDefinition>Auto</ColumnDefinition>
                <ColumnDefinition>Auto</ColumnDefinition>
                <ColumnDefinition>*</ColumnDefinition>
                <ColumnDefinition>Auto</ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- DirectX Background Layer -->
            <muxc:SwapChainPanel x:Name="DxHeaderSwapChainPanel" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Image Grid.Row="0" Grid.Column="0" Height="28" Margin="12,0,8,0"
                   Source="/Assets/VanaraMonkey.png" Stretch="Uniform" Width="28" VerticalAlignment="Center" />

            <!-- AppBar Overlay -->
            <StackPanel Grid.Column ="1" Grid.Row="0" Grid.RowSpan="2" Margin="7" Orientation="Vertical" VerticalAlignment="Center" >
                <Image x:Name="LeftOverlayLogo" HorizontalAlignment="Left" MaxHeight="64" Source="/Assets/Vanara/Vanara-64px.png" 
                       VerticalAlignment="Center"/>
                <TextBlock FontSize="32" FontWeight="SemiBold" Text="Vanara Jñāna"/>
                <TextBlock FontSize="13" Opacity="0.7" Text="v5+ - Development Build"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
                <controls:FeatureTile Icon="&#xE71E;" Subtitle="Official Releases." Title="NuGet"/>
                <controls:FeatureTile Icon="&#xE8A5;" Subtitle="Browse Source Code." Title="GitHub"/>
                <controls:FeatureTile Icon="&#xE8A5;" Subtitle="Search Types, Members and Interfaces." Title="APIs"/>
                <controls:FeatureTile Icon="&#xE8EF;" Subtitle="IlSpy Packages or Binaries." Title="Wrappers"/>
                <controls:FeatureTile Icon="&#xE8EF;" Subtitle="View Examples." Title="Samples"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Grid.Row="1" Orientation="Horizontal">

            </StackPanel>

            <!-- WinUI SailBoat Header Image -->
            <Image x:Name="SailBoatHeader" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right"
                   IsHitTestVisible="False" Opacity="0.92" Source="/Assets/WinUi-SailBoat-Header-32bit.png" VerticalAlignment="Stretch" />
        </Grid>

        <Grid x:Name="MainContentGrid" Grid.Row="1" Background="#1E2A38" Opacity="0.76" Padding="32" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Shell Namespace Tree -->
            <controls:ShellNamespaceTree x:Name="ShellNamespaceTree" Grid.Column="0" BorderThickness="3" BorderBrush="Beige" 
                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Grid.Column="1" BorderThickness="3" BorderBrush="Beige" Margin="7">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="What this tool does."/>
                    <TextBlock Opacity="0.8" Text="This Explorer lets you browse Vanara APIs, inspect types, view samples, explore NuGet versions, and understand wrapper relationships. It is powered by reflection, NuGet metadata, and the Vanara test suite." TextWrapping="Wrap"/>
                    <TextBlock FontWeight="SemiBold" Margin="0,12,0,0" Text="Core Features"/>
                    <TextBlock Text="• API Tree (Namespaces → Types → Members)" TextWrapping="Wrap"/>
                    <TextBlock Text="• NuGet Version Selector" TextWrapping="Wrap"/>
                    <TextBlock Text="• Sample Mapping (Unit Tests → API)" TextWrapping="Wrap"/>
                    <TextBlock Text="• Wrapper Detection (IShellItem → ShellItem)" TextWrapping="Wrap"/>
                    <TextBlock Text="• Reflection‑based Metadata" TextWrapping="Wrap"/>
                    <TextBlock Text="• TaskScheduler Integration" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Padding="32" Spacing="12" HorizontalAlignment="Left" BorderThickness="3" BorderBrush="Beige" Margin="7">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="What this tool does."/>
                <TextBlock Opacity="0.8" Text="This Explorer lets you browse Vanara APIs, inspect types, view samples, explore NuGet versions, and understand wrapper relationships. It is powered by reflection, NuGet metadata, and the Vanara test suite." TextWrapping="Wrap"/>
                <TextBlock FontWeight="SemiBold" Margin="0,12,0,0" Text="Core Features"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="• API Tree (Namespaces → Types → Members)" TextWrapping="Wrap"/>
                    <TextBlock Text="• NuGet Version Selector" TextWrapping="Wrap"/>
                    <TextBlock Text="• Sample Mapping (Unit Tests → API)" TextWrapping="Wrap"/>
                    <TextBlock Text="• Wrapper Detection (IShellItem → ShellItem)" TextWrapping="Wrap"/>
                    <TextBlock Text="• Reflection‑based Metadata" TextWrapping="Wrap"/>
                    <TextBlock Text="• TaskScheduler Integration" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <controls:FloatingStatusBar x:Name="StatusBar" Grid.Row="2" HorizontalAlignment="Center" 
                                    VerticalAlignment="Bottom" Margin="0,0,0,24"/>
    </Grid>
</Page>
