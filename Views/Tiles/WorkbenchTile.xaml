<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jnana.Views.Tiles.WorkbenchTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jnana.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Jnana.Views.Tiles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--<vm:WorkbenchTileViewModel x:Key="WorkbenchTileViewModel" />-->
        <Style x:Key="TileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TileDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </UserControl.Resources>

    <Grid Padding="12" Tapped="Grid_OnTapped">
        <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TileTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Description}" Style="{StaticResource TileDescriptionStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
