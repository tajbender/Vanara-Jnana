<UserControl
    x:Class="Jnana.Controls.MarkdownPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Spacing="12" Padding="12">
            <Button Content="Open" Command="{x:Bind ViewModel.OpenCommand}" />
            <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" />
            <Button Content="Preview" Command="{x:Bind ViewModel.TogglePreviewCommand}" />
        </StackPanel>

        <!-- Split View -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*">

            <!-- Editor -->
            <TextBox
                Grid.Column="0"
                Text="{x:Bind ViewModel.MarkdownText, Mode=TwoWay}"
                FontFamily="Consolas"
                FontSize="14"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                Background="#1E1E1E"
                Foreground="White"
                BorderThickness="0"
                Padding="12" />

            <!-- Preview -->
            <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.PreviewVisibility}">
                <!--<labs:MarkdownTextBlock
                    Markdown="{x:Bind ViewModel.MarkdownText, Mode=OneWay}"
                    FontSize="14"
                    TextWrapping="Wrap"
                    LinkForeground="DodgerBlue"
                    CodeBackground="#1E1E1E"
                    CodeForeground="White"
                    Padding="12" />-->
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
