<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Jnana.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrls="using:Jnana.Workbench.Controls"
    mc:Ignorable="d"
    Title="Vanara jñāna">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>
    <Grid Padding="16,0,16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- QuickLaunchBar -->
        <ctrls:QuickLaunchBar x:Name="QuickLaunchBar" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" 
                              PageRequested="QuickLaunchBar_PageRequested" VerticalAlignment="Stretch" />
        <!-- TitleBar-->
        <TitleBar x:Name="AppTitleBar" Grid.Column="1" Grid.Row="0"
                  IsBackButtonEnabled="{x:Bind IsBackButtonEnabled, Mode=OneWay}"
                  IsBackButtonVisible="{x:Bind IsBackButtonVisible, Mode=OneWay}"
                  Subtitle="{x:Bind SubtitleText, Mode=OneWay}"
                  Title="{x:Bind TitleText, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Icons/vanara-Jnana.ico"/>
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <AutoSuggestBox IsEnabled="False" PlaceholderText="Search..." QueryIcon="Find" VerticalAlignment="Center"/>
            </TitleBar.RightHeader>
            <!--<TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="MinimizeWindowBtn" Click="MinimizeButton_Click" IsEnabled="False">
                        <FontIcon Glyph="&#xE921;"/>
                        -->
            <!-- Subtract -->
            <!--
                    </Button>
                    <Button x:Name="MaximizeWindowBtn" Click="MaximizeButton_Click">
                        <FontIcon Glyph="&#xE7F8;"/>
                        -->
            <!-- Square -->
            <!--
                    </Button>
                    <Button x:Name="CloseWindowBtn" Click="CloseButton_Click">
                        <FontIcon Glyph="&#xE8BB;"/>
                        -->
            <!-- Dismiss -->
            <!--
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>-->
        </TitleBar>

        <!-- Navigation Host -->
        <ctrls:NavigationHost x:Name="NavigationHost" Grid.Column="1" Grid.Row="1" VerticalAlignment="Stretch"/>

        <ctrls:FloatingStatusBar Grid.Column="1" Grid.Row="2"/>

        <Border x:Name="EasterEggLayer" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#CC000000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <TextBlock FontFamily="Cascadia Mono" Foreground="Lime" Text="Congratulations! You found the Easter Egg."/>
                <AppBarSeparator Margin="0,10,0,10"/>
                <TextBlock FontFamily="Cascadia Mono" Foreground="Lime" Text="You weren't supposed to be here, you know?" Margin="0,10,0,0"/>
                <AppBarSeparator Margin="0,10,0,10"/>
                <TextBlock FontFamily="Cascadia Mono" Foreground="Lime" Text="However, glad to see you here, Mr. Falken." Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
